{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "http:default",
    "fs:allow-exists",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/**"]
    },
    {
      "identifier": "http:default",
      "allow": ["https://*:*"],
      "requireLiteralLeadingDot": false
    }
  ]
}
